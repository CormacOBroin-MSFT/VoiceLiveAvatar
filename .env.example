AZURE_VOICELIVE_ENDPOINT=
AZURE_VOICELIVE_API_KEY=
VOICELIVE_MODEL=gpt-realtime
VOICELIVE_VOICE=en-US-AvaMultilingualNeural
VOICELIVE_VOICE_SPEED=100
VOICELIVE_AVATAR_ENABLED=true
VOICELIVE_ENABLE_PRIMING=false
VOICELIVE_ENABLE_PROACTIVE=true
# Long-form defaults are loaded from defaults/instructions.txt and defaults/priming.json

# Latency logging (optional)
# Per-turn voice-to-voice latency is logged to the console and an append-only
# JSONL file. Disable by setting LATENCY_LOG_ENABLED=false. Customise the file
# location with LATENCY_LOG_FILE.
LATENCY_LOG_ENABLED=true
LATENCY_LOG_FILE=logs/latency.jsonl
